{
  "name": "optimus-prime-business",
  "version": "0.1.0",
  "private": true,
  "description": "Optimus Prime Business desktop and mobile AI business assistant.",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build && tsc -p electron/tsconfig.json",
    "preview": "vite preview",
    "mobile:init": "npx cap add android",
    "mobile:sync": "npm run build:web && npx cap sync android",
    "build:web": "tsc -p tsconfig.app.json && vite build",
    "dist:win": "npm run build && electron-builder --win nsis",
    "lint": "eslint ."
  },
  "dependencies": {
    "@capacitor/core": "6.2.1",
    "dotenv": "16.4.7",
    "lucide-react": "0.468.0",
    "mammoth": "1.8.0",
    "pdf-parse": "1.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "6.2.1",
    "@capacitor/cli": "6.2.1",
    "@types/node": "22.10.2",
    "@types/pdf-parse": "1.1.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "electron": "32.3.3",
    "electron-builder": "25.1.8",
    "eslint": "9.17.0",
    "typescript": "5.7.2",
    "vite": "5.4.11"
  },
  "build": {
    "appId": "com.primeltd.optimusprimebusiness",
    "productName": "Optimus Prime Business",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "CLAUDE.md",
      "Core/**/*",
      "Knowledge/**/*",
      ".claude/skills/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
